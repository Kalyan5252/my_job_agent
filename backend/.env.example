# =============================
# App Runtime
# =============================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_TIME_WINDOW_MS=60000
# Set true when running behind a reverse proxy / load balancer (correct client IPs for rate limits).
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API (empty = no browser CORS).
CORS_ORIGINS=

# =============================
# API authentication (required in production)
# =============================
# Generate everything with:  bun run auth:hash-password --secrets
# Static API keys for CLI/cron/CI, comma-separated (>= 24 chars each).
# Use as `Authorization: Bearer <key>` or `x-api-key: <key>`.
API_KEYS=
# Username/password login at POST /auth/login -> short-lived bearer token.
ADMIN_USERNAME=admin
# Keep the single quotes: the hash contains '$'.
ADMIN_PASSWORD_HASH=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=43200
AUTH_LOGIN_RATE_LIMIT_MAX=10
# Local development only; refused when NODE_ENV=production.
AUTH_DISABLED=false

# =============================
# Runtime data (resumes, profiles, sessions, screenshots, exports)
# =============================
DATA_DIR=data
# Encrypts saved LinkedIn/Google sessions at rest (>= 32 chars). Required in production.
DATA_ENCRYPTION_KEY=
MAX_RESUME_UPLOAD_BYTES=10485760
# Allow headed browsers on the API host (interactive login, preview, CAPTCHA hand-off).
# Defaults to true in development and false in production.
# BROWSER_INTERACTIVE_ENABLED=
# Use an installed browser instead of Playwright's bundled Chromium (e.g. chrome). Leave empty in Docker.
BROWSER_CHANNEL=

# =============================
# AI Provider Selection
# =============================
# Main LLM provider used for scoring/decision/mapping/status.
# Allowed: openai | openrouter
AI_PROVIDER=openrouter

# Optional scraper-assist model on HTML pages.
AI_SCRAPER_ENABLED=true
# Allowed: openai | openrouter
AI_SCRAPER_PROVIDER=openrouter

# =============================
# OpenAI (used when AI_PROVIDER=openai or AI_SCRAPER_PROVIDER=openai)
# =============================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_JOB_SCORING=gpt-5.4
OPENAI_MODEL_JOB_DECISION=gpt-5.4
OPENAI_MODEL_FORM_UNDERSTANDING=gpt-5.4
OPENAI_MODEL_FIELD_MAPPING=gpt-5.4
OPENAI_MODEL_ANSWER_GENERATION=gpt-5.4
OPENAI_MODEL_EMAIL_PARSING=gpt-5.4
OPENAI_MODEL_STATUS_CLASSIFICATION=gpt-5.4
OPENAI_MODEL_SCRAPER=gpt-5.4-mini

# =============================
# OpenRouter (used when AI_PROVIDER=openrouter or AI_SCRAPER_PROVIDER=openrouter)
# =============================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_JOB_SCORING=google/gemma-4-31b-it
OPENROUTER_MODEL_JOB_DECISION=google/gemma-4-31b-it
OPENROUTER_MODEL_FORM_UNDERSTANDING=google/gemma-4-31b-it
OPENROUTER_MODEL_FIELD_MAPPING=google/gemma-4-31b-it
OPENROUTER_MODEL_ANSWER_GENERATION=google/gemma-4-31b-it
OPENROUTER_MODEL_EMAIL_PARSING=google/gemma-4-31b-it
OPENROUTER_MODEL_STATUS_CLASSIFICATION=google/gemma-4-31b-it
OPENROUTER_MODEL_SCRAPER=google/gemma-4-31b-it
OPENROUTER_RATE_LIMIT_MAX_RETRIES=2
OPENROUTER_RATE_LIMIT_RETRY_DELAY_MS=1500
DISCOVERY_SCORE_BATCH_DELAY_MS=1000
DISCOVERY_SCORE_RATE_LIMIT_BATCH_SIZE=10

# =============================
# Groq (optional; currently disabled)
# =============================
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_SCRAPER=openai/gpt-oss-20b
GROQ_SCRAPER_ENABLED=false

# =============================
# Discovery / Scraper
# =============================
SCRAPER_ALLOW_SYNTHETIC_FALLBACK=false
SCRAPER_DEFAULT_COUNTRY=India
SCRAPER_REMOTE_BOOST=false
EXPORT_GOOGLE_SHEETS_ENABLED=false
# Path to the service-account JSON key file, or the raw JSON string.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Optional: Shared Drive folder ID to create exports in (avoids service-account storage quota limits).
GOOGLE_SHEETS_DRIVE_FOLDER_ID=
# Optional: email to share each created spreadsheet with so a human can open it.
GOOGLE_SHEETS_SHARE_EMAIL=
INDIAN_JOB_SOURCES_ENABLED=true
LINKEDIN_SCRAPER_ENABLED=true

# Adzuna keys are optional; supported country codes include in, us, gb, ca, au, de, fr, nz, pl, br, at, za.
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# JSearch via RapidAPI. The scraper maps request country to the provider country code.
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# =============================
# LinkedIn / Google sessions (application agent)
# =============================
# Sessions are saved via the API (PUT /sessions/:provider or POST /sessions/:provider/login)
# or `bun run session <linkedin|google>`; stored encrypted under DATA_DIR/auth/.
LINKEDIN_AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=true
GOOGLE_AUTH_DOMAIN_ALLOWLIST=

# =============================
# Candidate profile / resume
# =============================
# Upload resumes via POST /profile/resume; files live under DATA_DIR.
# Optional overrides (absolute or relative paths):
# RESUME_FILE_PATH=
# CANDIDATE_PROFILE_PATH=
# MANUAL_PROFILE_PATH=
# Email used when an application form needs your secondary (Google) identity.
# SECONDARY_EMAIL=

# =============================
# Databases
# =============================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=job_agent

# Use full URI (example for Neon):
# postgresql://user:password@host/db?sslmode=require
POSTGRES_URL=postgresql://user:password@host/db?sslmode=require
POSTGRES_SSL_MODE=prefer
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# =============================
# Redis / Queue
# =============================
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
DISCOVERY_SCRAPE_WORKER_CONCURRENCY=4
DISCOVERY_AI_WORKER_CONCURRENCY=4
DISCOVERY_WRITE_WORKER_CONCURRENCY=2
APPLY_WORKER_CONCURRENCY=1

# =============================
# Schedules (cron worker)
# =============================
DISCOVERY_CRON=0 */6 * * *
TRACKING_CRON=*/20 * * * *
TRACKING_LOOKBACK_DAYS=7

# =============================
# Email Tracking
# =============================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_imap_app_password
IMAP_TLS=true

# =============================
# Default Discovery Profile
# =============================
DEFAULT_JOB_ROLE=Backend Engineer
DEFAULT_JOB_SKILLS=TypeScript,Node.js,Express.js,MongoDB,PostgreSQL,Redis,AWS,GCP,Docker,GraphQL,RAG,LLM,LangChain,React,Next.js
DEFAULT_JOB_EXPERIENCE=junior

# =============================
# Email digest (optional)
# =============================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Job Agent <job-agent@example.com>
DIGEST_RECIPIENT_EMAIL=
