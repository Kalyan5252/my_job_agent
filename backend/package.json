{
  "name": "@job-agent/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API and distributed workers for the job agent",
  "main": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:worker": "bun --watch src/queues/worker.ts",
    "dev:discovery-worker": "bun --watch src/queues/discovery.worker.main.ts",
    "dev:cron": "bun --watch scripts/cronJobs.ts",
    "start": "bun src/server.ts",
    "start:worker": "bun src/queues/worker.ts",
    "start:discovery-worker": "bun src/queues/discovery.worker.main.ts",
    "start:cron": "bun scripts/cronJobs.ts",
    "session": "bun scripts/session.ts",
    "auth:hash-password": "bun scripts/hashPassword.ts",
    "browsers:install": "bunx playwright install chromium",
    "check:company-sources": "bun scripts/checkCompanySources.ts",
    "check:apify-source": "bun scripts/checkApifySource.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests --timeout 60000"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "bullmq": "^5.12.7",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "googleapis": "^144.0.0",
    "imap": "^0.8.19",
    "ioredis": "^5.4.1",
    "mailparser": "^3.7.1",
    "mongodb": "^6.8.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "playwright": "1.59.1",
    "unpdf": "1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/imap": "^0.8.42",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/bun": "1.3.9"
  }
}
